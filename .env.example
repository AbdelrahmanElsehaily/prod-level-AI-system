# Copy this file to .env and fill in values for local development.
# .env is in .gitignore — never commit it.
# This file (.env.example) is safe to commit: no real values, just variable names.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatapi

# --- Cache ---
REDIS_URL=redis://localhost:6379

# --- AI provider: Ollama ---
# Ollama supports both local and cloud models using the same client.
#
# Option A: Ollama Cloud (recommended — no local GPU needed)
#   1. Sign up at https://ollama.com
#   2. Get an API key at https://ollama.com/settings/keys
#   3. Use any model with the :cloud suffix (full list: https://ollama.com/search?c=cloud)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=llama3.2:cloud
OLLAMA_API_KEY=
#
# Option B: Local Ollama
#   1. Install Ollama: https://ollama.com/download
#   2. Start the server: ollama serve
#   3. Pull a model: ollama pull llama3.2
#   Then set:
#     OLLAMA_BASE_URL=http://localhost:11434   (or http://host.docker.internal:11434 inside Docker)
#     OLLAMA_MODEL=llama3.2
#     OLLAMA_API_KEY=                          (leave empty — no auth for local)

# --- Observability (optional — leave blank in local dev) ---
SENTRY_DSN=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=

# --- Environment ---
# Controls log format: "development" = pretty console, "production" = JSON
ENVIRONMENT=development
